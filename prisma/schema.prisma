// Schéma Prisma — Sous le Pommier
// Modèle complet défini dans l'issue #3

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enum ───────────────────────────────────────────────────────────────────

enum Role {
  GERANT
  VENDEUR
}

enum StatutVente {
  OUVERTE
  FINALISEE
  ANNULEE
}

enum ModeReglement {
  ESPECES
  CB
  CHEQUE
  VIREMENT
  TICKET_RESTO
}

enum TypeEmballage {
  VRAC
  BARQUETTE
  FILET
  SAC
  CAISSE
  PLATEAU
}

enum StatutFacture {
  BROUILLON
  EMISE
  PAYEE
  ANNULEE
}

// ─── Utilisateurs ────────────────────────────────────────────────────────────

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  nom             String
  prenom          String
  role            Role     @default(VENDEUR)
  actif           Boolean  @default(true)
  passwordHash    String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lastLoginAt     DateTime?
  rgpdConsent     Boolean  @default(false)
  rgpdConsentDate DateTime?

  ventes        Vente[]
  clotures      ClotureCaisse[]
  auditActions  JournalAudit[]

  @@map("users")
}

// ─── Produits ─────────────────────────────────────────────────────────────────

model Categorie {
  id       String    @id @default(cuid())
  nom      String    @unique
  produits Produit[]

  @@map("categories")
}

model Produit {
  id          String    @id @default(cuid())
  nom         String
  categorieId String?
  image       String?
  description String?
  actif       Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  categorie Categorie?        @relation(fields: [categorieId], references: [id])
  variantes VarianteProduit[]

  @@map("produits")
}

model VarianteProduit {
  id          String        @id @default(cuid())
  produitId   String
  poids       Decimal?      @db.Decimal(10, 3)
  unitePoidsId String?
  emballage   TypeEmballage @default(VRAC)
  prixHT      Decimal       @db.Decimal(10, 4)
  tauxTVA     Decimal       @db.Decimal(5, 2)
  prixTTC     Decimal       @db.Decimal(10, 4)
  sku         String?       @unique
  actif       Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  produit     Produit      @relation(fields: [produitId], references: [id])
  lignesVente LigneVente[]

  @@map("variantes_produit")
}

// ─── Ventes ──────────────────────────────────────────────────────────────────

model Vente {
  id            String      @id @default(cuid())
  numeroTicket  String      @unique
  vendeurId     String
  date          DateTime    @default(now())
  totalHT       Decimal     @db.Decimal(10, 4)
  totalTTC      Decimal     @db.Decimal(10, 4)
  totalTVA      Decimal     @db.Decimal(10, 4)
  statut        StatutVente @default(OUVERTE)
  hash          String
  hashPrecedent String?
  motifAnnulation String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  vendeur    User         @relation(fields: [vendeurId], references: [id])
  lignes     LigneVente[]
  paiements  Paiement[]
  factures   Facture[]

  @@index([date])
  @@index([vendeurId])
  @@map("ventes")
}

model LigneVente {
  id              String   @id @default(cuid())
  venteId         String
  varianteProduitId String
  qte             Decimal  @db.Decimal(10, 3)
  prixUnitaireHT  Decimal  @db.Decimal(10, 4)
  tauxTVA         Decimal  @db.Decimal(5, 2)
  montantHT       Decimal  @db.Decimal(10, 4)
  montantTVA      Decimal  @db.Decimal(10, 4)
  montantTTC      Decimal  @db.Decimal(10, 4)
  remise          Decimal  @default(0) @db.Decimal(5, 2)

  vente    Vente           @relation(fields: [venteId], references: [id])
  variante VarianteProduit @relation(fields: [varianteProduitId], references: [id])

  @@map("lignes_vente")
}

model Paiement {
  id             String        @id @default(cuid())
  venteId        String
  mode           ModeReglement
  montant        Decimal       @db.Decimal(10, 4)
  renduMonnaie   Decimal       @default(0) @db.Decimal(10, 4)
  reference      String?
  createdAt      DateTime      @default(now())

  vente Vente @relation(fields: [venteId], references: [id])

  @@map("paiements")
}

// ─── Clôture caisse ──────────────────────────────────────────────────────────

model ClotureCaisse {
  id             String   @id @default(cuid())
  numeroCloture  Int      @unique
  date           DateTime
  gerantId       String
  nbVentes       Int      @default(0)
  totalEspeces   Decimal  @db.Decimal(10, 4)
  totalCB        Decimal  @db.Decimal(10, 4)
  totalCheque    Decimal  @db.Decimal(10, 4)
  totalVirement  Decimal  @db.Decimal(10, 4)
  totalTR        Decimal  @db.Decimal(10, 4)
  totalVentes    Decimal  @db.Decimal(10, 4)
  totalHT        Decimal  @db.Decimal(10, 4)
  totalTVA       Decimal  @db.Decimal(10, 4)
  totalTTC       Decimal  @db.Decimal(10, 4)
  recapVendeurs  Json?
  recapTVA       Json?
  recapProduits  Json?
  ventesAnnulees Json?
  hashCumulatif  String
  pdfUrl         String?
  createdAt      DateTime @default(now())

  gerant User @relation(fields: [gerantId], references: [id])

  @@index([date])
  @@map("clotures_caisse")
}

// ─── Facturation B2B ─────────────────────────────────────────────────────────

model Client {
  id                    String   @id @default(cuid())
  raisonSociale         String
  siret                 String?  @unique
  tvaIntracommunautaire String?
  adresse               String?
  codePostal            String?
  ville                 String?
  pays                  String   @default("FR")
  email                 String?
  telephone             String?
  conditionsPaiement    Int      @default(30)
  notes                 String?
  actif                 Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  factures Facture[]

  @@map("clients")
}

model Facture {
  id                 String        @id @default(cuid())
  numero             String        @unique
  clientId           String
  venteId            String?
  dateEmission       DateTime      @default(now())
  dateEcheance       DateTime?
  datePaiement       DateTime?
  dateLivraison      DateTime?
  statut             StatutFacture @default(BROUILLON)
  totalHT            Decimal       @db.Decimal(10, 4)
  totalTVA           Decimal       @db.Decimal(10, 4)
  totalTTC           Decimal       @db.Decimal(10, 4)
  pdfUrl             String?
  notes              String?
  factureOriginaleId String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  client           Client         @relation(fields: [clientId], references: [id])
  vente            Vente?         @relation(fields: [venteId], references: [id])
  factureOriginale Facture?       @relation("AvoirOf", fields: [factureOriginaleId], references: [id])
  avoirs           Facture[]      @relation("AvoirOf")
  lignes           LigneFacture[]

  @@index([clientId])
  @@index([statut])
  @@map("factures")
}

model LigneFacture {
  id             String  @id @default(cuid())
  factureId      String
  designation    String
  qte            Decimal @db.Decimal(10, 3)
  prixUnitaireHT Decimal @db.Decimal(10, 4)
  tauxTVA        Decimal @db.Decimal(5, 2)
  montantHT      Decimal @db.Decimal(10, 4)
  montantTVA     Decimal @db.Decimal(10, 4)
  montantTTC     Decimal @db.Decimal(10, 4)
  remise         Decimal @default(0) @db.Decimal(5, 2)

  facture Facture @relation(fields: [factureId], references: [id], onDelete: Cascade)

  @@map("lignes_facture")
}

// ─── Audit ────────────────────────────────────────────────────────────────────

model JournalAudit {
  id           String   @id @default(cuid())
  userId       String?
  action       String
  entite       String
  entiteId     String?
  ancienneValeur Json?
  nouvelleValeur Json?
  ip           String?
  userAgent    String?
  timestamp    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([timestamp])
  @@index([userId])
  @@index([entite, entiteId])
  @@map("journal_audit")
}

// ─── Configuration entreprise ────────────────────────────────────────────────

model ConfigEntreprise {
  id                    String  @id @default(cuid())
  raisonSociale         String
  formeJuridique        String?
  capitalSocial         Decimal? @db.Decimal(15, 2)
  siret                 String?
  tvaIntracommunautaire String?
  adresse               String?
  codePostal            String?
  ville                 String?
  pays                  String  @default("FR")
  telephone             String?
  email                 String?
  logoUrl               String?
  iban                  String?
  rcs                   String?
  villeRCS              String?
  codeAPE               String?
  regimeTVA             String  @default("NORMAL")
  responsableRGPD       String?
  emailRGPD             String?

  @@map("config_entreprise")
}

// ─── Taux TVA ────────────────────────────────────────────────────────────────

model TauxTVA {
  id          String   @id @default(cuid())
  libelle     String
  taux        Decimal  @db.Decimal(5, 2)
  actif       Boolean  @default(true)
  defaut      Boolean  @default(false)
  dateEffet   DateTime @default(now())
  createdAt   DateTime @default(now())

  @@map("taux_tva")
}

