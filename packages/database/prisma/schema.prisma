// Schéma Prisma — Sous le Pommier
// Normalisé 3FN (Merise N3) : FK vers TauxTVA, UnitePoids matérialisée,
// prixTTC retiré (calculé à la volée : prixHT × (1 + tauxTVA.taux/100))

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enum ───────────────────────────────────────────────────────────────────

enum Role {
  SUPERADMIN
  GERANT
  VENDEUR
}

enum StatutVente {
  OUVERTE
  FINALISEE
  ANNULEE
}

enum ModeReglement {
  ESPECES
  CB
  CHEQUE
  VIREMENT
  TICKET_RESTO
}

enum TypeEmballage {
  VRAC
  BARQUETTE
  FILET
  SAC
  CAISSE
  PLATEAU
}

enum StatutBL {
  BROUILLON
  EMIS
  LIVRE
  ANNULE
}

enum TypeDroitRGPD {
  ACCES
  RECTIFICATION
  EFFACEMENT
  PORTABILITE
  OPPOSITION
}

enum StatutDemandeRGPD {
  EN_ATTENTE
  EN_COURS
  TRAITEE
  REFUSEE
}

enum FrequenceAbonnement {
  HEBDO
  BIMENSUEL
  MENSUEL
}

enum StatutLivraison {
  PLANIFIEE
  LIVREE
  ANNULEE
}

// ─── Utilisateurs ────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  username        String    @unique
  email           String?   @unique
  nom             String
  prenom          String
  role            Role      @default(VENDEUR)
  actif           Boolean   @default(true)
  passwordHash    String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastLoginAt     DateTime?
  rgpdConsent     Boolean   @default(false)
  rgpdConsentDate DateTime?

  ventes              Vente[]
  clotures            ClotureCaisse[]
  auditActions        JournalAudit[]
  mouvementsStock     MouvementStock[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ─── Référentiel TVA ─────────────────────────────────────────────────────────

model TauxTVA {
  id          String   @id @default(cuid())
  libelle     String
  taux        Decimal  @db.Decimal(5, 2)
  actif       Boolean  @default(true)
  defaut      Boolean  @default(false)
  dateEffet   DateTime @default(now())
  createdAt   DateTime @default(now())

  variantes VarianteProduit[]

  @@map("taux_tva")
}

// ─── Référentiel unités de poids / conditionnement ───────────────────────────

model UnitePoids {
  id      String  @id @default(cuid())
  // symbole affiché (kg, g, L, pce, botte…)
  symbole String  @unique
  libelle String
  actif   Boolean @default(true)

  variantes VarianteProduit[]

  @@map("unites_poids")
}

// ─── Produits ─────────────────────────────────────────────────────────────────

model Categorie {
  id       String    @id @default(cuid())
  nom      String    @unique
  produits Produit[]

  @@map("categories")
}

model Produit {
  id              String   @id @default(cuid())
  nom             String
  categorieId     String?
  image           String?
  description     String?
  actif           Boolean  @default(true)
  saisonDebutMois Int?
  saisonDebutJour Int?
  saisonFinMois   Int?
  saisonFinJour   Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  categorie Categorie?        @relation(fields: [categorieId], references: [id])
  variantes VarianteProduit[]

  @@map("produits")
}

model VarianteProduit {
  id           String        @id @default(cuid())
  produitId    String
  // Conditionnement
  poids        Decimal?      @db.Decimal(10, 3)
  unitePoidsId String?
  emballage    TypeEmballage @default(VRAC)
  // Prix — N3 : prixTTC retiré (calculé = prixHT × (1 + tauxTVA.taux/100))
  prixHT       Decimal       @db.Decimal(10, 4)
  tauxTVAId    String
  // Vente
  sku          String?       @unique
  venteAuPoids Boolean       @default(false)
  // Stock (dénormalisation justifiée : lecture très fréquente, écriture rare)
  stockActuel  Decimal       @default(0) @db.Decimal(10, 3)
  stockMin     Decimal?      @db.Decimal(10, 3)
  actif        Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  produit    Produit    @relation(fields: [produitId], references: [id])
  tauxTVA    TauxTVA    @relation(fields: [tauxTVAId], references: [id])
  unitePoids UnitePoids? @relation(fields: [unitePoidsId], references: [id])

  lignesVente        LigneVente[]
  mouvementsStock    MouvementStock[]
  paliers            PalierRemise[]
  lignesAbonnement   LigneAbonnement[]
  lignesBonLivraison LigneBonLivraison[]

  @@index([produitId])
  @@index([tauxTVAId])
  @@map("variantes_produit")
}

model PalierRemise {
  id         String          @id @default(cuid())
  varianteId String
  qteMin     Decimal         @db.Decimal(10, 3)
  remisePct  Decimal         @db.Decimal(5, 2)

  variante VarianteProduit @relation(fields: [varianteId], references: [id], onDelete: Cascade)

  @@index([varianteId])
  @@map("paliers_remise")
}

// ─── Ventes ──────────────────────────────────────────────────────────────────

model Vente {
  id              String      @id @default(cuid())
  numeroTicket    String      @unique
  vendeurId       String
  date            DateTime    @default(now())
  // Totaux stockés : snapshot légal immuable (obligation fiscale française)
  totalHT         Decimal     @db.Decimal(10, 4)
  totalTTC        Decimal     @db.Decimal(10, 4)
  totalTVA        Decimal     @db.Decimal(10, 4)
  statut          StatutVente @default(OUVERTE)
  hash            String
  hashPrecedent   String?
  motifAnnulation String?
  pointDeVenteId  String?
  clientId        String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  vendeur      User          @relation(fields: [vendeurId], references: [id])
  pointDeVente PointDeVente? @relation(fields: [pointDeVenteId], references: [id])
  client       Client?       @relation(fields: [clientId], references: [id])
  lignes       LigneVente[]
  paiements    Paiement[]
  bonsLivraison BonLivraison[]
  livraisons   Livraison[]
  mouvementsStock MouvementStock[]

  @@index([date])
  @@index([vendeurId])
  @@index([statut])
  @@index([clientId])
  @@index([pointDeVenteId])
  @@map("ventes")
}

model LigneVente {
  id                String  @id @default(cuid())
  venteId           String
  varianteProduitId String
  qte               Decimal @db.Decimal(10, 3)
  // Snapshot prix au moment de la vente (immuable par obligation fiscale)
  prixUnitaireHT    Decimal @db.Decimal(10, 4)
  tauxTVA           Decimal @db.Decimal(5, 2)
  montantHT         Decimal @db.Decimal(10, 4)
  montantTVA        Decimal @db.Decimal(10, 4)
  montantTTC        Decimal @db.Decimal(10, 4)
  remise            Decimal @default(0) @db.Decimal(5, 2)

  vente    Vente           @relation(fields: [venteId], references: [id])
  variante VarianteProduit @relation(fields: [varianteProduitId], references: [id])

  @@index([venteId])
  @@index([varianteProduitId])
  @@map("lignes_vente")
}

model Paiement {
  id           String        @id @default(cuid())
  venteId      String
  mode         ModeReglement
  montant      Decimal       @db.Decimal(10, 4)
  renduMonnaie Decimal       @default(0) @db.Decimal(10, 4)
  reference    String?
  createdAt    DateTime      @default(now())

  vente Vente @relation(fields: [venteId], references: [id])

  @@index([venteId])
  @@map("paiements")
}

// ─── Stock ───────────────────────────────────────────────────────────────────

enum TypeMouvement {
  ENTREE
  SORTIE
  AJUSTEMENT
  VENTE
}

model MouvementStock {
  id         String        @id @default(cuid())
  varianteId String
  type       TypeMouvement
  quantite   Decimal       @db.Decimal(10, 3)
  motif      String?
  venteId    String?
  userId     String
  createdAt  DateTime      @default(now())

  variante VarianteProduit @relation(fields: [varianteId], references: [id])
  user     User            @relation(fields: [userId], references: [id])
  vente    Vente?          @relation(fields: [venteId], references: [id])

  @@index([varianteId])
  @@index([createdAt])
  @@index([userId])
  @@index([venteId])
  @@map("mouvements_stock")
}

// ─── Clôture caisse ──────────────────────────────────────────────────────────

model ClotureCaisse {
  id             String   @id @default(cuid())
  numeroCloture  Int      @unique
  date           DateTime
  gerantId       String
  nbVentes       Int      @default(0)
  // Totaux par mode et globaux : snapshot immuable pour comptabilité
  totalEspeces   Decimal  @db.Decimal(10, 4)
  totalCB        Decimal  @db.Decimal(10, 4)
  totalCheque    Decimal  @db.Decimal(10, 4)
  totalVirement  Decimal  @db.Decimal(10, 4)
  totalTR        Decimal  @db.Decimal(10, 4)
  totalVentes    Decimal  @db.Decimal(10, 4)
  totalHT        Decimal  @db.Decimal(10, 4)
  totalTVA       Decimal  @db.Decimal(10, 4)
  totalTTC       Decimal  @db.Decimal(10, 4)
  recapVendeurs  Json?
  recapTVA       Json?
  recapProduits  Json?
  ventesAnnulees Json?
  hashCumulatif  String
  pdfUrl         String?
  pointDeVenteId String?
  createdAt      DateTime @default(now())

  gerant       User          @relation(fields: [gerantId], references: [id])
  pointDeVente PointDeVente? @relation(fields: [pointDeVenteId], references: [id])

  @@index([date])
  @@map("clotures_caisse")
}

// ─── Facturation B2B ─────────────────────────────────────────────────────────

model Client {
  id                    String   @id @default(cuid())
  raisonSociale         String
  siret                 String?  @unique
  tvaIntracommunautaire String?
  adresse               String?
  codePostal            String?
  ville                 String?
  pays                  String   @default("FR")
  email                 String?
  telephone             String?
  conditionsPaiement    Int      @default(30)
  notes                 String?
  actif                 Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  ventes        Vente[]
  bonsLivraison BonLivraison[]
  abonnements   Abonnement[]

  @@map("clients")
}

model BonLivraison {
  id                String    @id @default(cuid())
  numero            String    @unique
  clientId          String
  venteId           String?
  dateEmission      DateTime  @default(now())
  dateLivraison     DateTime?
  statut            StatutBL  @default(BROUILLON)
  remiseCommerciale Decimal?  @db.Decimal(5, 2)
  // Snapshot total : immuable une fois le BL émis
  totalHT           Decimal   @db.Decimal(10, 4)
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  client Client              @relation(fields: [clientId], references: [id])
  vente  Vente?              @relation(fields: [venteId], references: [id])
  lignes LigneBonLivraison[]

  @@index([clientId])
  @@index([statut])
  @@map("bons_livraison")
}

model LigneBonLivraison {
  id                String  @id @default(cuid())
  bonLivraisonId    String
  varianteProduitId String?
  // Snapshot désignation au moment du BL (le nom produit peut changer)
  designation       String
  qte               Decimal @db.Decimal(10, 3)
  unite             String?
  prixUnitaireHT    Decimal @db.Decimal(10, 4)
  remise            Decimal @default(0) @db.Decimal(5, 2)
  // Snapshot montant : calculé à l'émission, immuable ensuite
  montantHT         Decimal @db.Decimal(10, 4)

  bonLivraison BonLivraison     @relation(fields: [bonLivraisonId], references: [id], onDelete: Cascade)
  variante     VarianteProduit? @relation(fields: [varianteProduitId], references: [id], onDelete: SetNull)

  @@index([bonLivraisonId])
  @@index([varianteProduitId])
  @@map("lignes_bon_livraison")
}

// ─── Audit ────────────────────────────────────────────────────────────────────

model JournalAudit {
  id             String   @id @default(cuid())
  userId         String?
  action         String
  entite         String
  entiteId       String?
  ancienneValeur Json?
  nouvelleValeur Json?
  ip             String?
  userAgent      String?
  timestamp      DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([timestamp])
  @@index([userId])
  @@index([entite, entiteId])
  @@map("journal_audit")
}

// ─── Configuration entreprise ────────────────────────────────────────────────

model ConfigEntreprise {
  id                    String   @id @default(cuid())
  raisonSociale         String
  formeJuridique        String?
  capitalSocial         Decimal? @db.Decimal(15, 2)
  siret                 String?
  tvaIntracommunautaire String?
  adresse               String?
  codePostal            String?
  ville                 String?
  pays                  String   @default("FR")
  telephone             String?
  email                 String?
  logoUrl               String?
  iban                  String?
  rcs                   String?
  villeRCS              String?
  codeAPE               String?
  regimeTVA             String   @default("NORMAL")
  responsableRGPD       String?
  emailRGPD             String?
  smtpHost              String?
  smtpPort              Int?
  smtpUser              String?
  smtpPass              String?
  smtpFrom              String?
  smtpTls               Boolean  @default(true)

  @@map("config_entreprise")
}

// ─── RGPD ────────────────────────────────────────────────────────────────────

model DemandeRGPD {
  id        String            @id @default(cuid())
  type      TypeDroitRGPD
  statut    StatutDemandeRGPD @default(EN_ATTENTE)
  nom       String
  email     String
  message   String?
  reponse   String?
  traitePar String?
  traiteAt  DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([statut])
  @@map("demandes_rgpd")
}

// ─── Points de vente ─────────────────────────────────────────────────────────

model PointDeVente {
  id        String   @id @default(cuid())
  nom       String
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())

  ventes   Vente[]
  clotures ClotureCaisse[]

  @@map("points_de_vente")
}

// ─── AMAP / Abonnements ──────────────────────────────────────────────────────

model Abonnement {
  id        String              @id @default(cuid())
  clientId  String
  nom       String
  frequence FrequenceAbonnement
  actif     Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  client     Client            @relation(fields: [clientId], references: [id])
  lignes     LigneAbonnement[]
  livraisons Livraison[]

  @@index([clientId])
  @@map("abonnements")
}

model LigneAbonnement {
  id                String  @id @default(cuid())
  abonnementId      String
  varianteProduitId String
  qte               Decimal @db.Decimal(10, 3)

  abonnement Abonnement      @relation(fields: [abonnementId], references: [id], onDelete: Cascade)
  variante   VarianteProduit @relation(fields: [varianteProduitId], references: [id])

  @@unique([abonnementId, varianteProduitId])
  @@index([abonnementId])
  @@map("lignes_abonnement")
}

model Livraison {
  id           String          @id @default(cuid())
  abonnementId String
  date         DateTime
  statut       StatutLivraison @default(PLANIFIEE)
  venteId      String?         @unique
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  abonnement Abonnement @relation(fields: [abonnementId], references: [id], onDelete: Cascade)
  vente      Vente?     @relation(fields: [venteId], references: [id])

  @@index([abonnementId])
  @@index([date])
  @@map("livraisons")
}
