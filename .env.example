# ─── PostgreSQL ────────────────────────────────────────────────────────────────
# Connexion directe (dev local ou CI)
DATABASE_URL="postgresql://pommier:changeme@localhost:5432/souslepommier"

# Identifiants du service postgres dans docker-compose.prod.yml
POSTGRES_USER=pommier
POSTGRES_PASSWORD=changeme
POSTGRES_DB=souslepommier

# ─── Auth / Session ────────────────────────────────────────────────────────────
# Générer : openssl rand -hex 32
JWT_SECRET="changeme_generate_with_openssl_rand_hex_32"
SIGNING_SECRET="changeme_minimum_32_chars_openssl_rand_hex_32"

# ─── Serveur API ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001
# Origine autorisée pour CORS (frontend Vite en dev)
WEB_ORIGIN=http://localhost:5173
# Cookie sécurisé — true en prod HTTPS, false en dev HTTP
COOKIE_SECURE=false
# Durée de session en secondes (28800 = 8h)
SESSION_MAX_AGE=28800

# ─── Email (SMTP) ──────────────────────────────────────────────────────────────
EMAIL_FROM="Sous le Pommier <noreply@example.com>"
EMAIL_SERVER_HOST=smtp.example.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=

# ─── Optionnel ─────────────────────────────────────────────────────────────────
# Clé pour l'endpoint /api/setup (première installation — laisser vide pour désactiver)
SETUP_SECRET=
# Port HTTP exposé par docker-compose.prod.yml
APP_PORT=80
