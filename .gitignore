# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
**/coverage/

# next.js (artefacts — projet migré vers Vite)
/.next/
**/apps/web/.next/
/out/
**/out/
# root Dockerfile obsolète (Next.js), remplacé par apps/api/Dockerfile + apps/web/Dockerfile
/Dockerfile
apps/web/next.config.ts
apps/web/next-env.d.ts
# SVGs boilerplate Next.js non utilisés
apps/web/public/next.svg
apps/web/public/vercel.svg
apps/web/public/file.svg
apps/web/public/globe.svg
apps/web/public/window.svg

# production
/build
**/dist/
apps/api/dist/

# misc
.DS_Store
Thumbs.db
*.pem

# éditeurs
.idea/
*.swp
*.swo
.vscode/settings.json

# Vite cache
**/.vite/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

src/generated/
packages/database/src/generated/

# Uploads utilisateur (logos, images) — sauf les .gitkeep
/public/uploads/**
!/public/uploads/**/.gitkeep
apps/web/public/uploads/**
!apps/web/public/uploads/**/.gitkeep

# Turbo cache
.turbo/
**/.turbo/

# Next.js build output (all apps)
**/.next/

# NestJS compiled output
apps/api/dist/

.claude/

.npmrc